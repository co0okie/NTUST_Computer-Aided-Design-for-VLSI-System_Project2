FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc g++ cmake make python3 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN if id ubuntu >/dev/null 2>&1; then userdel ubuntu; fi; useradd --create-home --uid 1000 --shell /bin/bash grader
USER grader
WORKDIR /home/grader
